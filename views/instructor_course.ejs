<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Course Details</title>
</head>

<link rel="stylesheet" href="/style.css">

<body>
    <h1>Manage Course: <%= course.course_id %> - <%= course.course_name %></h1>
    <!-- <a href="/instructor/dashboard">Back to Dashboard</a> -->
     <button onclick="window.location.href='/instructor/dashboard'">Back to Dashboard</button>

    <!-- logout button  -->
     <button onclick="window.location.href='/logout'">Logout</button>

    <hr>

    <h3>Welcome, <%= user_full_name %>!</h3>

    <!-- TODO: Add Student Form -->
    <!-- Input: Student Username -->
    <!-- Action: /instructor/add-student -->
    <h3>Add Student</h3>
    <form method="POST" action="/instructor/add-student">
    <input name="username" placeholder="Student Username">
    <input type="hidden" name="course_id" value="<%= courseId %>">
    <button>Add</button>
    </form>

    <!-- add optional error message -->
    <% if (err_message) { %>
        <p style="color: red;"><%= err_message %></p>
    <% } %>

    <!-- TODO: List Enrolled Students -->
    <!-- Show: Student ID, Name -->
    <!-- Action: Remove Button -->
    <h3>Enrolled Students</h3>
    <table>
    <tr style="background-color: #f2f2f2;"><th>Student ID</th><th>Username</th><th>Full Name</th><th>Action</th></tr>
    <% students.forEach(s => { %>
    <tr>
    <td><%= s.user_id %></td>
    <td><%= s.username %></td>
    <td><%= s.full_name %></td>
    <td>
    <form method="POST" action="/instructor/remove-student" style="display:inline">
    <input type="hidden" name="student_id" value="<%= s.user_id %>">
    <input type="hidden" name="course_id" value="<%= courseId %>">
    <button>Remove</button>
    </form>
    </td>
    </tr>
    <% }) %>
    </table>
</body>
</html>