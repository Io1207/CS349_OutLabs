<!DOCTYPE html>
<html lang="en">
<link rel="stylesheet" href="/style.css">
<head>
    <meta charset="UTF-8">
    <title>Instructor Dashboard</title>
</head>

<body>
    <h1>Instructor Dashboard</h1>
    <h3>Welcome, <%= user_full_name %>!</h3>
    <button onclick="window.location.href='/logout'">Logout</button>
    <!-- <a href="/logout">Logout</a> -->

    <!-- TODO: Display Courses Taught by Instructor -->
    <!-- Link to Course Details page (/instructor/course/:id) -->
    <h2>My Courses</h2>

    <ul>
    <% courses.forEach(c => { %>
    <li>
    <a href="/instructor/course/<%= c.course_id %>">
    <%= c.course_id %> - <%= c.course_name %>
    </a>
    </li>
    <% }) %>
    </ul>
    <hr>
    

</body>

</html>